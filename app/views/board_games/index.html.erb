<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px;">
  <h1 style="margin: 0;">Board Games</h1>
  <%= link_to "Add New Game", new_board_game_path, style: "color: #000; text-decoration: underline;" %>
</div>

<div style="display: flex; flex-direction: column; gap: 10px;">
  <% @board_games.each do |game| %>
    <div style="border: 1px solid #000; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center;">
      <strong><%= game.title %></strong>
      <span style="color: #555; font-size: 0.9em;">
        <%= game.min_players || "?" %> - <%= game.max_players || "?" %> Players
      </span>
    </div>
  <% end %>
</div>