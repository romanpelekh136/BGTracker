<h1>BoardGames#new</h1>
<p>Find me in app/views/board_games/new.html.erb</p>

<%= form_with model: @board_game do |f| %>
  <div>
    <%= f.label :title, "Title" %>
    <%= f.text_field :title %>
  </div>    
  
  <div>
    <%= f.label :desctiption, "Desctiption" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :min_players, "Minimum Players" %>
    <%= f.number_field :min_players %>
  </div>

   <div>
    <%= f.label :max_players, "Maximum Players" %>
    <%= f.number_field :max_players %>
  </div>
  
  <div>
    <%= f.submit "Submit", disable_with: 'Submitting...' %>
  </div>
<% end %>
  