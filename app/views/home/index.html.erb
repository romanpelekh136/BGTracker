<h1>Home#index</h1>

<h2>Recent Games</h2>

<div style="display: flex; overflow-x: auto; gap: 20px; padding-bottom: 15px;">
  <% @matches.each do |match| %>
    <div style="border: 2px solid #000; padding: 15px; min-width: 200px; flex-shrink: 0;">
      
      <h3 style="margin: 0 0 5px 0;">
        <%= link_to match.board_game.title, match_path(match) %>
      </h3>
      
      <p style="margin: 0 0 15px 0; font-size: 0.8em; color: #333;">
        <%= match.created_at.strftime("%B %d, %Y") %>
      </p>

      <% winners = match.match_results.select { |result| result.rank == 1 } %>
      
      <% if winners.any? %>
        <strong>Winner: <%= winners.map { |winner| winner.player.username }.join(', ') %> </strong>
      <% end %>
      
    </div>
  <% end %>
</div>

<p><%= link_to "Add New Match", new_match_path %></p>

<%= link_to "Add Board Game", new_board_game_path %>