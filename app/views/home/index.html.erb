<div style="display: flex; align-items: baseline; gap: 15px; margin-bottom: 15px;">
  <h2 style="margin: 0;">Recent Matches</h2>
  <%= link_to "View All Matches", matches_path, style: "color: #000; text-decoration: underline; font-size: 0.9em;" %>
</div>

<div style="display: flex; overflow-x: auto; gap: 15px; padding-bottom: 15px; margin-bottom: 20px;">
  <% @matches.each do |match| %>
    <div style="border: 1px solid #000; padding: 15px; min-width: 220px; flex-shrink: 0; display: flex; flex-direction: column; justify-content: space-between;">
      
      <div>
        <h3 style="margin: 0 0 5px 0;">
          <%= link_to match.board_game.title, match_path(match), style: "color: #000; text-decoration: none; font-weight: bold;" %>
        </h3>
        <p style="margin: 0 0 15px 0; font-size: 0.8em; color: #555;">
          <%= match.created_at.strftime("%B %d, %Y") %>
        </p>
      </div>

      <% winners = match.match_results.select { |result| result.rank == 1 } %>
      
      <% if winners.any? %>
        <div style="font-size: 0.9em; border-top: 1px dotted #000; padding-top: 10px;">
          <strong>👑 <%= winners.map { |winner| winner.player.username }.join(', ') %></strong>
        </div>
      <% end %>
      
    </div>
  <% end %>
</div>

<div style="display: flex; gap: 15px;">
  <%= link_to "Add New Match", new_match_path, style: "padding: 8px 16px; border: 1px solid #000; background: #000; color: #fff; text-decoration: none;" %>
  <%= link_to "Add Board Game", new_board_game_path, style: "padding: 8px 16px; border: 1px solid #000; background: #fff; color: #000; text-decoration: none;" %>
</div>